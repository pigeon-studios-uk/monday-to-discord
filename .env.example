# Monday to Discord settings.
# Copy this file to .env and fill it in, or set these as environment variables on your host.
# Never commit .env or share these values.

# Required. A long random value that goes in the webhook address monday.com calls:
#   https://<your-host>/monday/<RELAY_SECRET>
# Generate one with:  node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
RELAY_SECRET=replace-with-a-long-random-value

# Recommended. A monday.com API token, so messages show board names, group names and people instead of IDs.
# monday.com: your avatar → Developers → My access tokens.
MONDAY_API_TOKEN=

# Discord webhooks, referred to from config.json as "env:NAME".
DISCORD_WEBHOOK_DEPLOYMENTS=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
DISCORD_WEBHOOK_TEAM=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Optional.
# PORT=3000
# CONFIG_PATH=config.json
# RULES_JSON=          (the whole of config.json as one line, for hosts without a file system)
# MONDAY_API_VERSION=  (such as 2025-10; monday.com's current version if left out)
# FOOTER_TEXT=Monday to Discord
# DEBUG=false          (true logs every event in full: only while setting up)
